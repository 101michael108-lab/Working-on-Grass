# =============================================================================
# LOCAL DEVELOPMENT ONLY — copy to .env.local
# =============================================================================
# Production & preview deploys use Firebase App Hosting (apphosting.yaml + secrets).
# Do not rely on this file in production. See docs/ENVIRONMENT.md
# =============================================================================

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — mirrors App Hosting secret: payfast-passphrase
PAYFAST_PASSPHRASE=your-sandbox-passphrase

# Sandbox checkout (when Firestore settings/config isLiveMode is false)
# Live merchant ID/key are stored in Firestore, not env, for production.
NEXT_PUBLIC_PAYFAST_SANDBOX_MERCHANT_ID=10043133
NEXT_PUBLIC_PAYFAST_SANDBOX_MERCHANT_KEY=wh7ky81lq556u

# Firebase Admin SDK — local API routes only (ITN, track-order, admin session)
# App Hosting uses Application Default Credentials automatically.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
