rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingDoc() {
      return resource != null;
    }

    // Admin = custom claim set by /api/auth/session (ADMIN_UIDS)
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // ------------------------------------------------------------------
    // Users & nested orders
    // ------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.id == userId
        && request.resource.data.role == 'user';
      allow update: if (isOwner(userId)
        && isExistingDoc()
        && request.resource.data.role == resource.data.role)
        || (isAdmin() && isExistingDoc());
      allow delete: if isOwner(userId) || isAdmin();

      match /orders/{orderId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) && request.resource.data.userId == userId)
          || isAdmin();
        allow update: if (isAdmin() && isExistingDoc())
          || (isOwner(userId)
            && isExistingDoc()
            && request.resource.data.userId == resource.data.userId);
        allow delete: if isOwner(userId) || isAdmin();

        match /orderItems/{orderItemId} {
          allow read: if isOwner(userId) || isAdmin();
          allow create: if isOwner(userId) || isAdmin();
          allow update, delete: if (isOwner(userId) || isAdmin()) && isExistingDoc();
        }
      }
    }

    // Collection group: admin orders dashboard (collectionGroup 'orders')
    match /{path=**}/orders/{orderId} {
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Products
    // ------------------------------------------------------------------

    match /products/{productId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && isExistingDoc();
    }

    // ------------------------------------------------------------------
    // Site images & media library
    // ------------------------------------------------------------------

    match /siteImages/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mediaLibrary/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Resources
    // ------------------------------------------------------------------

    match /resources/{resourceId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Settings
    // ------------------------------------------------------------------

    match /settings/config {
      allow get: if true;
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Mail (Trigger Email extension)
    // ------------------------------------------------------------------

    match /mail/{mailId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Leads & inquiries
    // ------------------------------------------------------------------

    match /contactFormEntries/{id} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /consultationRequests/{id} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
